{$PUBLIC_HOST} {
    basic_auth {
        {$ADMIN_USER} {$ADMIN_PASSWORD_HASH}
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy same-origin
        -Server
    }
    @home path /
    handle @home {
        root * /srv/rolemint
        file_server
    }
    handle {
        reverse_proxy app:3000
    }
}
